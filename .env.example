# Copy to .env and set your AEMET Open Data API key.
# Register at https://opendata.aemet.es/centrodedescargas/inicio
AEMET_API_KEY=

# Example local SQLite file. For file URLs, ensure the parent directory exists
# (or use :memory: / another path / a remote DB). The app does not create directories.
DATABASE_URL=sqlite+aiosqlite:///./data/meteo.sqlite

# Browser origins allowed to call the API (JSON array). Required for the SPA.
CORS_ORIGINS=["http://localhost:3000"]

